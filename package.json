{
  "name": "project-last-stand",
  "version": "0.1.0",
  "description": "Project Last Stand - an original browser-based 3D battle royale survival shooter with an authoritative Node.js server.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:browser": "node scripts/browser-smoke.mjs",
    "map": "node scripts/render-map.mjs docs/map.png",
    "build": "node scripts/build-static.mjs",
    "test:play": "node scripts/playthrough.mjs",
    "test:load": "node scripts/loadtest.mjs",
    "check": "node scripts/check-server.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  }
}
