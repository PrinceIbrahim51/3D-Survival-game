{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-static.mjs",
  "outputDirectory": "public",
  "fluid": true,
  "regions": ["bom1"],
  "functions": {
    "api/ws.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
